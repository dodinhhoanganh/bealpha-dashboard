generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "core", "ddex", "finance", "analytics", "log"]
}

////////////////////
/// AUTH SCHEMA  ///
////////////////////

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  password            String    @map("password_hash")
  name                String?
  stageName           String?   @map("stage_name")
  phone               String?
  avatar              String?
  isActive            Boolean   @default(true) @map("is_active")
  isBanned            Boolean   @default(false) @map("is_banned")
  banReason           String?   @map("ban_reason")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime? @map("lockout_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // 2FA fields
  twoFactorEnabled       Boolean  @default(false) @map("two_factor_enabled")
  twoFactorMethod        String?  @map("two_factor_method")
  twoFactorSecret        String?  @map("two_factor_secret")
  twoFactorRecoveryCodes String[] @default([]) @map("two_factor_recovery_codes")

  // Preferences
  language        String  @default("en") @map("language")
  timezone        String  @default("Asia/Ho_Chi_Minh") @map("timezone")
  currency        String  @default("USD") @map("currency")
  theme           String  @default("dark") @map("theme")
  notifyReleases  Boolean @default(true) @map("notify_releases")
  notifyRoyalties Boolean @default(true) @map("notify_royalties")
  notifyNews      Boolean @default(true) @map("notify_news")
  notifyMarketing Boolean @default(false) @map("notify_marketing")

  // Relations — entity-based (B2B2B)
  entityRoles    UserEntityRole[]
  roles          UserRole[]
  twoFactorCodes TwoFactorCode[]
  notifications  Notification[]
  authTokens     AuthToken[]
  invitations    Invitation[]     @relation("InvitationSender")

  @@map("users")
  @@schema("auth")
}

model TwoFactorCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String
  method    String // 'email', 'phone'
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@map("two_factor_codes")
  @@schema("auth")
}

model AuthToken {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") // Hashed token for security (opaque token) or JWT jti
  userId     String   @map("user_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  deviceName String?  @map("device_name") // e.g. "MacBook Pro", "iPhone 13"
  deviceType String?  @map("device_type") // e.g. "desktop", "mobile", "tablet"
  location   String?
  hardwareId String?  @map("hardware_id")
  latitude   Decimal? @db.Decimal(8, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  isp        String? // Internet Service Provider name
  riskScore  Int?     @map("risk_score") // 0-100 risk score at login time
  loginType  String?  @map("login_type") // 'normal' | 'new_device' | 'new_location' | 'impossible_travel'
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  isValid    Boolean  @default(true) @map("is_valid")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("auth_tokens")
  @@schema("auth")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  displayName String  @map("display_name")
  description String?
  isSystem    Boolean @default(false) @map("is_system") // System roles cannot be deleted

  users UserRole[]

  @@map("roles")
  @@schema("auth")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("auth")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String // release_approved, release_denied, new_royalty, delivery_confirmed, delivery_failed, system
  title     String
  message   String
  read      Boolean  @default(false)
  link      String? // Deep link panel e.g. "products", "earnings", "distribution"
  metadata  Json? // Extra data (releaseId, deliveryId, etc.)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
  @@schema("auth")
}

////////////////////
/// CORE SCHEMA  ///
////////////////////

// ==========================================
// B2B2B 3-Tier Multi-Tenancy Enums
// ==========================================
enum EntityType {
  SUPER_ADMIN
  SYSTEM_ADMIN
  ORGANIZATION
  SUB_ACCOUNT

  @@schema("core")
}

enum EntityRole {
  OWNER
  ADMIN
  MEMBER

  @@schema("core")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@schema("auth")
}

// ==========================================
// BUSINESS ENTITY — 3-tier hierarchy node
// Replaces old Distributor model
// ==========================================
model BusinessEntity {
  id           String     @id @default(uuid()) @db.Uuid
  entityType   EntityType @map("entity_type")
  parentId     String?    @map("parent_id") @db.Uuid
  officialName String     @map("official_name")
  path         String // Hierarchy path e.g. "root.sysadmin1.org5.sub12"
  logoUrl      String?    @map("logo_url")
  description  String?
  metadata     Json? // Extra config, branding
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  parent        BusinessEntity?  @relation("EntityHierarchy", fields: [parentId], references: [id])
  children      BusinessEntity[] @relation("EntityHierarchy")
  userRoles     UserEntityRole[]
  labels        Label[]
  artists       Artist[]
  releases      Release[]        @relation("ReleaseTenant")
  ownedReleases Release[]        @relation("ReleaseOwner")
  invitations   Invitation[]

  @@unique([parentId, entityType, officialName])
  @@index([parentId])
  @@index([entityType])
  @@index([path])
  @@map("business_entities")
  @@schema("core")
}

// ==========================================
// USER ↔ ENTITY bridge table
// ==========================================
model UserEntityRole {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  entityId  String     @map("entity_id") @db.Uuid
  role      EntityRole
  createdAt DateTime   @default(now()) @map("created_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity BusinessEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
  @@index([userId])
  @@index([entityId])
  @@map("user_entity_roles")
  @@schema("auth")
}

// ==========================================
// INVITATION — Entity-First onboarding
// ==========================================
model Invitation {
  id         String       @id @default(uuid()) @db.Uuid
  entityId   String       @map("entity_id") @db.Uuid
  email      String
  role       EntityRole   @default(MEMBER)
  token      String       @unique
  status     InviteStatus @default(PENDING)
  invitedBy  String       @map("invited_by") @db.Uuid
  expiresAt  DateTime     @map("expires_at")
  acceptedAt DateTime?    @map("accepted_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  entity  BusinessEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  inviter User           @relation("InvitationSender", fields: [invitedBy], references: [id])

  @@index([email])
  @@index([token])
  @@index([entityId])
  @@map("invitations")
  @@schema("auth")
}

model Label {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String
  description   String?
  dpid          String? // DDEX Party Identifier
  ddexPartyName String?  @map("ddex_party_name")
  logoUrl       String?  @map("logo_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant       BusinessEntity @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  artists      Artist[]
  ddexMessages DdexMessage[]
  releases     Release[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("labels")
  @@schema("core")
}

model Artist {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  labelId      String?  @map("label_id") @db.Uuid
  name         String
  isni         String? @unique // International Standard Name Identifier — globally unique
  ipi          String? @unique // Interested Party Information — globally unique
  dpid         String? // DDEX Party Identifier
  imageUrl     String?  @map("image_url")
  spotifyId    String?  @map("spotify_id")
  appleMusicId String?  @map("apple_music_id")
  vevoChannel  String?  @map("vevo_channel")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        BusinessEntity     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label         Label?             @relation(fields: [labelId], references: [id], onDelete: SetNull)
  releases      Release[]
  tracks        Track[]
  contributions TrackContributor[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([labelId])
  @@map("artists")
  @@schema("core")
}

// ==========================================
// DDEX PRODUCT (Release)
// ==========================================
model Release {
  id String @id @default(uuid()) @db.Uuid

  // Basic Info
  title             String
  titleLocalized    Json?   @map("title_localized")
  subtitle          String?
  subtitleLocalized Json?   @map("subtitle_localized")

  // Release Identification
  ean             String? @unique
  grid            String? @unique
  catalogueNumber String? @map("catalogue_number")

  // Release Details
  type                ReleaseType   @default(AUDIO)
  format              ReleaseFormat @default(SINGLE)
  genre               String?
  subGenre            String?       @map("sub_genre")
  releaseDate         DateTime      @map("release_date")
  originalReleaseDate DateTime?     @map("original_release_date")
  metaLanguage        String?       @default("en") @map("meta_language")
  parentalWarningType String        @default("NotExplicit") @map("parental_warning_type")
  releaseNotes        String?       @map("release_notes")

  // Artist Info
  artistId               String? @map("artist_id") @db.Uuid
  displayArtist          String? @map("display_artist")
  displayArtistLocalized Json?   @map("display_artist_localized")

  // Credits
  remixer  String?
  producer String?

  // Label Info
  labelId String? @map("label_id") @db.Uuid

  // Copyright
  pLine     String? @map("p_line")
  cLine     String? @map("c_line")
  pLineYear Int?    @map("p_line_year")
  cLineYear Int?    @map("c_line_year")

  // Cover Art
  coverUrl           String? @map("cover_url")
  coverImageFileName String? @map("cover_image_file_name")

  // Distribution
  territories          String? @default("WORLDWIDE")
  excludingTerritories String? @map("excluding_territories")
  outlets              String?

  // Status & Workflow (Multi-level)
  status ReleaseStatus @default(DRAFT)

  // B2B2B Ownership
  tenantId String @map("tenant_id") @db.Uuid // Organization that owns this
  ownerId  String @map("owner_id") @db.Uuid // Entity that created this (sub-account or org)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  artist     Artist?        @relation(fields: [artistId], references: [id], onDelete: SetNull)
  label      Label?         @relation(fields: [labelId], references: [id], onDelete: SetNull)
  tenant     BusinessEntity @relation("ReleaseTenant", fields: [tenantId], references: [id])
  owner      BusinessEntity @relation("ReleaseOwner", fields: [ownerId], references: [id])
  tracks     Track[]
  assets     Asset[]
  deliveries DdexDelivery[]

  @@index([artistId])
  @@index([labelId])
  @@index([releaseDate])
  @@index([status])
  @@index([tenantId])
  @@index([ownerId])
  @@map("releases")
  @@schema("core")
}

enum ReleaseType {
  AUDIO
  VIDEO

  @@schema("core")
}

enum ReleaseFormat {
  SINGLE
  EP
  ALBUM
  COMPILATION

  @@schema("core")
}

enum ReleaseStatus {
  DRAFT
  PENDING_ORG_APPROVAL
  ORG_REJECTED
  PENDING_SYS_APPROVAL
  SYS_REJECTED
  APPROVED
  SCHEDULED
  DELIVERED
  RELEASED
  TAKEDOWN

  @@schema("core")
}

// ==========================================
// DDEX RECORDING (Track)
// ==========================================
model Track {
  id        String @id @default(uuid()) @db.Uuid
  releaseId String @map("release_id") @db.Uuid

  // Basic Info
  title                     String
  titleLocalized            Json?   @map("title_localized")
  subtitle                  String? // Version (Remix, Radio Edit, etc.)
  subtitleLocalized         Json?   @map("subtitle_localized")
  alternativeTitle          String? @map("alternative_title")
  alternativeTitleLocalized Json?   @map("alternative_title_localized")

  // Recording Identification
  isrc            String? @unique // International Standard Recording Code
  catalogueNumber String? @map("catalogue_number")

  // Track Details
  trackNumber         Int     @default(1) @map("track_number")
  discNumber          Int     @default(1) @map("disc_number")
  duration            Int? // Duration in seconds
  genre               String?
  parentalWarningType String  @default("NotExplicit") @map("parental_warning_type")
  lyrics              String? @db.Text // Full lyrics text
  lyricsLanguage      String? @map("lyrics_language") // ISO language code
  audioLanguage       String? @map("audio_language") // ISO language code for vocals

  // Creation Info
  creationDate      DateTime? @map("creation_date")
  countryOfCreation String?   @map("country_of_creation") // ISO country code

  // Artist Info (Primary)
  artistId               String? @map("artist_id") @db.Uuid
  displayArtist          String? @map("display_artist")
  displayArtistLocalized Json?   @map("display_artist_localized")

  // Note: Detailed contributors (Featured, Producer, Remixer, Composer, etc.) 
  // are now strictly managed via the TrackContributor relational table.

  // Label Info for this recording
  recordingLabel          String?  @map("recording_label")
  recordingLabelLocalized Json?    @map("recording_label_localized")
  recordingLabelShare     Decimal? @map("recording_label_share") @db.Decimal(5, 2)

  // Territories
  territories          String? @default("WORLDWIDE")
  excludingTerritories String? @map("excluding_territories")

  // Contract Info
  contractPeriodBegins DateTime? @map("contract_period_begins")
  contractPeriodEnds   DateTime? @map("contract_period_ends")
  contractNumber       String?   @map("contract_number")

  // Audio Asset Reference
  audioAssetId String? @map("audio_asset_id") @db.Uuid
  snippetStart Int?    @map("snippet_start") // Preview start in seconds
  snippetEnd   Int?    @map("snippet_end") // Preview end in seconds

  // Composition Reference
  compositionId String? @map("composition_id") @db.Uuid

  // Visual & Multimedia
  canvasAssetId String? @map("canvas_asset_id") @db.Uuid
  motionAssetId String? @map("motion_asset_id") @db.Uuid

  // Apple Digital Masters
  admAssetId              String?  @map("adm_asset_id") @db.Uuid
  masteringEngineerEmail  String?  @map("mastering_engineer_email")

  // Marketing & Pitching Metadata
  pitchingNote        String? @map("pitching_note") @db.Text
  pitchingAmazonData  Json?   @map("pitching_amazon_data")
  pitchingSpotifyData Json?   @map("pitching_spotify_data")
  pitchingTidalData   Json?   @map("pitching_tidal_data")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  release          Release            @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  artist           Artist?            @relation(fields: [artistId], references: [id], onDelete: SetNull)
  audioAsset       Asset?             @relation("TrackAudio", fields: [audioAssetId], references: [id])
  canvasAsset      Asset?             @relation("TrackCanvas", fields: [canvasAssetId], references: [id])
  motionAsset      Asset?             @relation("TrackMotion", fields: [motionAssetId], references: [id])
  admAsset         Asset?             @relation("TrackADM", fields: [admAssetId], references: [id])
  composition      Composition?       @relation(fields: [compositionId], references: [id])
  playlistTracks   PlaylistTrack[]
  streamingMetrics StreamingMetrics[]
  contributors     TrackContributor[]

  @@index([releaseId])
  @@index([artistId])
  @@index([audioAssetId])
  @@index([canvasAssetId])
  @@index([motionAssetId])
  @@index([admAssetId])
  @@index([compositionId])
  @@map("tracks")
  @@schema("core")
}

// ==========================================
// DDEX CONTRIBUTOR (Strict Relational)
// ==========================================
model TrackContributor {
  id       String  @id @default(uuid()) @db.Uuid
  trackId  String  @map("track_id") @db.Uuid
  artistId String? @map("artist_id") @db.Uuid
  name     String? // For contributors without a full Artist profile

  // DDEX ResourceContributorRole (e.g. Composer, Lyricist, MainArtist, FeaturedArtist, Producer)
  role String

  // Optional share for publishing/royalties
  share Decimal? @db.Decimal(5, 2)

  // Track association
  track  Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  // Artist/Party association
  artist Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([trackId])
  @@index([artistId])
  @@map("track_contributors")
  @@schema("core")
}

// ==========================================
// ASSET (Audio/Video Files)
// ==========================================
model Asset {
  id String @id @default(uuid()) @db.Uuid

  // Asset Type
  type AssetType @default(AUDIO)

  // File Info
  fileName         String  @map("file_name")
  originalFileName String? @map("original_file_name")
  fileUrl          String  @map("file_url")
  fileSize         BigInt? @map("file_size") // in bytes
  mimeType         String? @map("mime_type")

  // Technical Specs (Audio)
  duration   Int? // in seconds
  sampleRate Int?    @map("sample_rate") // e.g., 44100, 48000
  bitRate    Int?    @map("bit_rate") // e.g., 320000
  channels   Int? // 1=mono, 2=stereo
  bitDepth   Int?    @map("bit_depth") // e.g., 16, 24, 32
  codec      String? // e.g., "FLAC", "WAV", "MP3"

  // Technical Specs (Video)
  width      Int?
  height     Int?
  frameRate  Decimal? @map("frame_rate") @db.Decimal(5, 2)
  videoCodec String?  @map("video_codec")
  audioCodec String?  @map("audio_codec")

  // DDEX Resource Info
  isrc              String? // Can be linked to track ISRC
  resourceReference String? @map("resource_reference") // DDEX ResourceReference

  // Release Association
  releaseId String? @map("release_id") @db.Uuid

  // Processing Status
  status          AssetStatus @default(PENDING)
  processingError String?     @map("processing_error")

  // Copyright Check
  copyrightStatus    CopyrightStatus @default(UNCHECKED) @map("copyright_status")
  copyrightDetails   Json?           @map("copyright_details") // matches, durations, reasons
  copyrightCheckedAt DateTime?       @map("copyright_checked_at")

  // Timestamps
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  release      Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  tracks       Track[]  @relation("TrackAudio")
  tracksCanvas Track[]  @relation("TrackCanvas")
  tracksMotion Track[]  @relation("TrackMotion")
  tracksADM    Track[]  @relation("TrackADM")

  @@index([releaseId])
  @@index([type])
  @@index([status])
  @@map("assets")
  @@schema("core")
}

enum AssetType {
  AUDIO // Audio file (WAV, FLAC, MP3)
  VIDEO // Music Video
  CANVAS // Spotify Canvas
  MOTION // Apple Music Album Motion

  @@schema("core")
}

enum AssetStatus {
  PENDING // Waiting to be processed
  PROCESSING // Being transcoded/analyzed
  READY // Ready for use
  ERROR // Processing failed
  ARCHIVED // No longer active

  @@schema("core")
}

enum CopyrightStatus {
  UNCHECKED // Not yet scanned
  CLEAN // No copyright issues
  WARNING // Partial match, needs admin review
  REJECTED // Fully copyrighted, auto-rejected

  @@schema("core")
}

// ==========================================
// COMPOSITION (Musical Work - Publishing)
// ==========================================
model Composition {
  id String @id @default(uuid()) @db.Uuid

  // Basic Info
  title                     String
  titleLocalized            Json?   @map("title_localized")
  subtitle                  String?
  subtitleLocalized         Json?   @map("subtitle_localized")
  alternativeTitle          String? @map("alternative_title")
  alternativeTitleLocalized Json?   @map("alternative_title_localized")

  // Composition Identification
  iswc            String? @unique // International Standard Musical Work Code
  catalogueNumber String? @map("catalogue_number")

  // Details
  genre           String?
  creationDate    DateTime? @map("creation_date")
  lyricsLanguages String?   @map("lyrics_languages") // Comma-separated language codes
  lyricsFileName  String?   @map("lyrics_file_name")

  // Territories
  territories          String? @default("WORLDWIDE")
  excludingTerritories String? @map("excluding_territories")

  // Contract Info
  contractPeriodBegins DateTime? @map("contract_period_begins")
  contractPeriodEnds   DateTime? @map("contract_period_ends")
  contractNumber       String?   @map("contract_number")

  // Authors (stored as JSON for flexibility)
  authors Json?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  tracks Track[]

  @@map("compositions")
  @@schema("core")
}

////////////////////
/// DDEX SCHEMA  ///
////////////////////

model DdexMessage {
  id         String   @id @default(uuid()) @db.Uuid
  labelId    String?  @map("label_id") @db.Uuid
  version    String?
  rawXml     String?  @map("raw_xml")
  parsedJson Json?    @map("parsed_json")
  status     String?
  receivedAt DateTime @default(now()) @map("received_at")

  label Label? @relation(fields: [labelId], references: [id])

  @@index([labelId])
  @@map("messages")
  @@schema("ddex")
}

model DdexDelivery {
  id          String    @id @default(uuid()) @db.Uuid
  releaseId   String    @map("release_id") @db.Uuid
  dspName     String    @map("dsp_name")
  messageType String    @default("NewRelease") @map("message_type")
  ernVersion  String    @default("4.3") @map("ern_version")
  xmlContent  String?   @map("xml_content") @db.Text
  batchId     String?   @map("batch_id")
  status      String    @default("pending")
  sentAt      DateTime? @map("sent_at")
  confirmedAt DateTime? @map("confirmed_at")
  errorLog    String?   @map("error_log") @db.Text
  metadata    String?   @map("metadata") @db.Text // Staging manifest, receipt paths, timeout
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@index([dspName])
  @@index([status])
  @@index([batchId])
  @@map("deliveries")
  @@schema("ddex")
}

///////////////////////
/// ANALYTICS SCHEMA ///
///////////////////////

model Playlist {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  platform   String // Spotify, Apple Music, etc.
  coverUrl   String?  @map("cover_url")
  followers  Int      @default(0)
  plays      Int      @default(0)
  color      String? // Color code for UI display
  externalId String?  @unique @map("external_id") // Platform-specific playlist ID
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tracks PlaylistTrack[]

  @@index([platform])
  @@map("playlists")
  @@schema("analytics")
}

model PlaylistTrack {
  id         String   @id @default(uuid()) @db.Uuid
  playlistId String   @map("playlist_id") @db.Uuid
  trackId    String   @map("track_id") @db.Uuid
  position   Int      @default(0)
  addedAt    DateTime @default(now()) @map("added_at")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@index([trackId])
  @@map("playlist_tracks")
  @@schema("analytics")
}

model StreamingMetrics {
  id              String   @id @default(uuid()) @db.Uuid
  trackId         String   @map("track_id") @db.Uuid
  date            DateTime @db.Date
  platform        String // Spotify, Apple Music, etc.
  country         String?
  plays           Int      @default(0)
  skips           Int      @default(0)
  saves           Int      @default(0)
  shares          Int      @default(0)
  avgPlayDuration Int?     @map("avg_play_duration") // Average duration in seconds
  createdAt       DateTime @default(now()) @map("created_at")

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, date, platform, country])
  @@index([trackId])
  @@index([date])
  @@index([platform])
  @@map("streaming_metrics")
  @@schema("analytics")
}

model DailyAnalytics {
  id              String   @id @default(uuid()) @db.Uuid
  date            DateTime @unique @db.Date
  totalPlays      Int      @default(0) @map("total_plays")
  totalSkips      Int      @default(0) @map("total_skips")
  skipRate        Float    @default(0) @map("skip_rate")
  avgPlayDuration Float    @default(0) @map("avg_play_duration")
  newFollowers    Int      @default(0) @map("new_followers")
  totalSaves      Int      @default(0) @map("total_saves")
  totalShares     Int      @default(0) @map("total_shares")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("daily_analytics")
  @@schema("analytics")
}

model PlayDurationBucket {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  range     String // "0-30s", "30s-1m", "1-2m", "2-3m", "3m+"
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date, range])
  @@index([date])
  @@map("play_duration_buckets")
  @@schema("analytics")
}

///////////////////////
/// FINANCE SCHEMA  ///
///////////////////////

model RoyaltyReport {
  id           String    @id @default(uuid()) @db.Uuid
  period       String // "2026-Q1", "2026-01"
  platform     String
  totalRevenue Decimal   @map("total_revenue") @db.Decimal(12, 4)
  totalPlays   Int       @default(0) @map("total_plays")
  currency     String    @default("USD")
  status       String    @default("pending") // pending, processed, paid
  reportUrl    String?   @map("report_url")
  receivedAt   DateTime  @default(now()) @map("received_at")
  processedAt  DateTime? @map("processed_at")

  lineItems RoyaltyLineItem[]

  @@unique([period, platform])
  @@index([period])
  @@index([platform])
  @@map("royalty_reports")
  @@schema("finance")
}

model RoyaltyLineItem {
  id        String  @id @default(uuid()) @db.Uuid
  reportId  String  @map("report_id") @db.Uuid
  isrc      String?
  trackName String? @map("track_name")
  plays     Int     @default(0)
  revenue   Decimal @db.Decimal(10, 4)
  country   String?

  report RoyaltyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([isrc])
  @@map("royalty_line_items")
  @@schema("finance")
}

///////////////////////
/// LOG SCHEMA      ///
///////////////////////

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("log")
}

model SystemLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     String // info, warn, error, debug
  message   String
  context   Json?
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([level])
  @@index([createdAt])
  @@map("system_logs")
  @@schema("log")
}
