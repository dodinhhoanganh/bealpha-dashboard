# Copy to .env.microservices. Use independent random hex secrets.

# Edge
COMPOSE_PARALLEL_LIMIT=1
COMPOSE_BAKE=false
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_SERVER_NAMES=localhost 127.0.0.1
GATEWAY_PLATFORM_HOSTNAMES=localhost,127.0.0.1
GATEWAY_TENANT_DOMAIN_CACHE_TTL_SECONDS=30
CORS_ORIGINS=https://dashboard.example.com
# Browser uses same-origin /api/v1 through Nginx by default.
NEXT_PUBLIC_API_BASE_URL=
LOG_LEVEL=info

# PostgreSQL admin and isolated service credentials
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_64_HEX_POSTGRES_ADMIN
IDENTITY_DB_PASSWORD=CHANGE_ME_64_HEX_IDENTITY_DB
CATALOG_DB_PASSWORD=CHANGE_ME_64_HEX_CATALOG_DB
MEDIA_DB_PASSWORD=CHANGE_ME_64_HEX_MEDIA_DB
DISTRIBUTION_DB_PASSWORD=CHANGE_ME_64_HEX_DISTRIBUTION_DB
FINANCE_DB_PASSWORD=CHANGE_ME_64_HEX_FINANCE_DB
NOTIFICATION_DB_PASSWORD=CHANGE_ME_64_HEX_NOTIFICATION_DB
ANALYTICS_DB_PASSWORD=CHANGE_ME_64_HEX_ANALYTICS_DB
AUDIT_DB_PASSWORD=CHANGE_ME_64_HEX_AUDIT_DB

# Redis. Keep URL-safe because Compose embeds it in REDIS_URL.
REDIS_PASSWORD=CHANGE_ME_64_HEX_REDIS

# ES256 access-token pair. Identity gets PKCS8 private key; Gateway gets SPKI public key.
IDENTITY_ACCESS_TOKEN_PRIVATE_KEY_B64=CHANGE_ME_BASE64_PKCS8_ACCESS_PRIVATE_KEY
GATEWAY_ACCESS_TOKEN_PUBLIC_KEY_B64=CHANGE_ME_BASE64_SPKI_ACCESS_PUBLIC_KEY
GATEWAY_ACCESS_TOKEN_ISSUER=bealpha-identity
GATEWAY_ACCESS_TOKEN_AUDIENCE=bealpha-api
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=900

# ES256 internal-context pair. Gateway gets private key; services get public key.
GATEWAY_INTERNAL_CONTEXT_PRIVATE_KEY_B64=CHANGE_ME_BASE64_PKCS8_CONTEXT_PRIVATE_KEY
GATEWAY_INTERNAL_CONTEXT_PUBLIC_KEY_B64=CHANGE_ME_BASE64_SPKI_CONTEXT_PUBLIC_KEY
GATEWAY_INTERNAL_CONTEXT_ISSUER=bealpha-gateway
GATEWAY_INTERNAL_CONTEXT_AUDIENCE=bealpha-services
GATEWAY_INTERNAL_CONTEXT_TTL_SECONDS=30

# Identity resource/session policy
IDENTITY_DB_POOL_MAX=10
IDENTITY_REFRESH_TTL_SECONDS=604800
IDENTITY_REMEMBER_REFRESH_TTL_SECONDS=2592000
IDENTITY_BCRYPT_COST=12
IDENTITY_MAX_LOGIN_ATTEMPTS=5
IDENTITY_LOCKOUT_SECONDS=900
IDENTITY_2FA_CHALLENGE_TTL_SECONDS=600
IDENTITY_2FA_MAX_ATTEMPTS=5
IDENTITY_TOTP_ISSUER=BeAlpha
IDENTITY_TOTP_WINDOW=1
IDENTITY_TOTP_STEP_SECONDS=30
IDENTITY_TOTP_DIGITS=6
IDENTITY_PASSWORD_RESET_TTL_SECONDS=1800
IDENTITY_PASSWORD_RESET_COOLDOWN_SECONDS=60
IDENTITY_OUTBOX_ENCRYPTION_KEY_B64=CHANGE_ME_BASE64_32_BYTE_KEY
IDENTITY_OUTBOX_POLL_INTERVAL_MS=1000
IDENTITY_OUTBOX_BATCH_SIZE=25
IDENTITY_INVITATION_TTL_SECONDS=604800
IDENTITY_INVITATION_RESEND_COOLDOWN_SECONDS=60
IDENTITY_2FA_EMAIL_CODE_TTL_SECONDS=600
IDENTITY_2FA_EMAIL_COOLDOWN_SECONDS=60
IDENTITY_2FA_EMAIL_MAX_SENDS=5
IDENTITY_2FA_EMAIL_RATE_WINDOW_SECONDS=600

# Catalog resource policy
CATALOG_DB_POOL_MAX=10
CATALOG_BODY_LIMIT_BYTES=32768
CATALOG_OUTBOX_POLL_MS=1000
CATALOG_OUTBOX_BATCH_SIZE=100
CATALOG_IMPORT_GRANT_ENCRYPTION_KEY_B64=CHANGE_ME_BASE64_32_BYTE_KEY
CATALOG_IMPORT_MAX_BYTES=53687091200
CATALOG_IMPORT_MAX_ENTRIES=10000
CATALOG_IMPORT_MAX_XML_BYTES=268435456
CATALOG_IMPORT_WORKER_POLL_MS=1000
CATALOG_IMPORT_WORKER_MAX_ATTEMPTS=3
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Analytics resource policy
ANALYTICS_DB_POOL_MAX=10
ANALYTICS_BODY_LIMIT_BYTES=65536

# Audit projection policy
AUDIT_DB_POOL_MAX=10
AUDIT_BODY_LIMIT_BYTES=32768

# Media resource/storage policy
MEDIA_PUBLIC_BASE_URL=https://api.example.com
MEDIA_DB_POOL_MAX=10
MEDIA_CONTROL_BODY_LIMIT_BYTES=32768
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_UPLOAD_MAX_BYTES=53687091200
MEDIA_UPLOAD_CONCURRENCY=4
MEDIA_STREAM_GRANT_TTL_SECONDS=60
MEDIA_PREVIEW_GRANT_MAX_USES=8
MEDIA_DELIVERY_GRANT_TTL_SECONDS=3600
MEDIA_DELIVERY_GRANT_MAX_USES=5
MEDIA_STREAM_CONCURRENCY=32
MEDIA_WORKER_POLL_MS=1000
MEDIA_WORKER_MAX_ATTEMPTS=3
MEDIA_ARCHIVE_RETENTION_SECONDS=86400

# Distribution policy. Mount complete licensed schema directories so relative imports resolve offline.
DISTRIBUTION_NODE_ENV=production
DISTRIBUTION_ERN_XSD_PATH=/ddex/ern/release-notification.xsd
DISTRIBUTION_ACK_XSD_PATH=/ddex/ernc/ern-choreography-sftp.xsd
DISTRIBUTION_DB_POOL_MAX=10
DISTRIBUTION_BODY_LIMIT_BYTES=65536
DISTRIBUTION_ERN_XSD_HOST_DIR=./ddex/official/ern-4.3.2
# Include allowed-value-sets.xsd and a valid W3C xmldsig-core-schema.xsd in this directory.
DISTRIBUTION_ACK_XSD_HOST_DIR=./ddex/official/ern-c-sftp-18.1
DISTRIBUTION_DDEX_SENDER_PARTY_ID=PA-DPIDA-2025021503-U
DISTRIBUTION_DDEX_SENDER_NAME=ADED Music Group LLC
DISTRIBUTION_DDEX_AVS_VERSION_ID=9
DISTRIBUTION_GRANT_ENCRYPTION_KEY_B64=CHANGE_ME_BASE64_32_BYTE_KEY
DISTRIBUTION_EXPORT_SIGNING_KEY_B64=CHANGE_ME_BASE64_32_BYTE_KEY
DISTRIBUTION_PUBLIC_BASE_URL=https://localhost
DISTRIBUTION_EXPORT_DOWNLOAD_TTL_SECONDS=900
DISTRIBUTION_EXPORT_RETENTION_SECONDS=86400
DISTRIBUTION_DSP_RECIPIENTS_JSON={"manual_aded":{"partyId":"PA-DPIDA-2025021503-U","name":"ADED Manual Custody"}}
DISTRIBUTION_STORE_TARGETS_JSON={"spotify":{"name":"Spotify","releaseTypes":["AUDIO"]},"apple_music":{"name":"Apple Music","releaseTypes":["AUDIO"]},"amazon_music":{"name":"Amazon Music","releaseTypes":["AUDIO"]},"youtube_music":{"name":"YouTube Music","releaseTypes":["AUDIO"]},"deezer":{"name":"Deezer","releaseTypes":["AUDIO"]},"tidal":{"name":"TIDAL","releaseTypes":["AUDIO"]},"tiktok":{"name":"TikTok","releaseTypes":["AUDIO"]},"meta":{"name":"Meta","releaseTypes":["AUDIO"]},"vevo":{"name":"VEVO","releaseTypes":["VIDEO"]}}
DISTRIBUTION_AUTO_PREPARE_DDEX_PACKAGES=true
DISTRIBUTION_SFTP_DELIVERY_ENABLED=false
DISTRIBUTION_MANUAL_DDEX_RECIPIENT_ID=manual_aded
DISTRIBUTION_WORKER_POLL_MS=1000
DISTRIBUTION_WORKER_MAX_ATTEMPTS=5
DISTRIBUTION_ACK_POLL_MS=60000
DISTRIBUTION_PACKAGE_MAX_BYTES=53687091200
DISTRIBUTION_PACKAGE_MAX_ENTRIES=10000
DISTRIBUTION_SFTP_PRIVATE_KEY_HOST_PATH=./secrets/dsp_sftp_key
DISTRIBUTION_SFTP_KNOWN_HOSTS_HOST_PATH=./secrets/dsp_known_hosts
DISTRIBUTION_SFTP_TARGETS_JSON={"spotify":{"host":"sftp.example.com","port":22,"username":"replace_me","remoteDir":"/incoming","privateKeyPath":"/run/secrets/dsp_sftp_key","knownHostsPath":"/run/secrets/dsp_known_hosts"}}

# Finance streaming ingestion
FINANCE_PUBLIC_BASE_URL=https://api.example.com
FINANCE_DB_POOL_MAX=10
FINANCE_BODY_LIMIT_BYTES=65536
FINANCE_UPLOAD_TTL_SECONDS=900
FINANCE_UPLOAD_MAX_BYTES=53687091200
FINANCE_UPLOAD_CONCURRENCY=2
FINANCE_WORKER_POLL_MS=1000
FINANCE_WORKER_MAX_ATTEMPTS=3
FINANCE_WORKER_BATCH_SIZE=500
FINANCE_OUTBOX_POLL_MS=1000
FINANCE_OUTBOX_BATCH_SIZE=100

# Notification API/worker and SMTP
APP_URL=https://dashboard.example.com
NOTIFICATION_DB_POOL_MAX=10
NOTIFICATION_BODY_LIMIT_BYTES=32768
NOTIFICATION_ENCRYPTION_KEY_B64=CHANGE_ME_BASE64_32_BYTE_KEY
NOTIFICATION_WORKER_POLL_MS=1000
NOTIFICATION_WORKER_MAX_ATTEMPTS=5
SMTP_HOST=smtp-relay.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_MESSAGE_ID_DOMAIN=mail.example.com
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=BeAlpha

# Resource and DoS limits
GATEWAY_BODY_LIMIT_BYTES=1048576
GATEWAY_UPSTREAM_TIMEOUT_MS=15000
GATEWAY_RATE_LIMIT_MAX=120
GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# Nginx edge profile requires:
# certs/fullchain.pem
# certs/privkey.pem
