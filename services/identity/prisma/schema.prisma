generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-v2"
}

datasource db {
  provider = "postgresql"
}

enum EntityType {
  SUPER_ADMIN
  SYSTEM_ADMIN
  ORGANIZATION
  SUB_ACCOUNT
}

enum EntityRole {
  OWNER
  ADMIN
  REVIEWER
  ACCOUNTANT
  MEMBER
}

enum StaffRole {
  admin
  moderator
  supporter
  finance
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SessionRevokeReason {
  LOGOUT
  ROTATED
  REVOKED_BY_USER
  REVOKED_BY_ADMIN
  PASSWORD_CHANGED
  REFRESH_REUSE
  ACCOUNT_DISABLED
}

model User {
  id                     String   @id @default(uuid()) @db.Uuid
  email                  String   @unique @db.VarChar(254)
  passwordHash           String   @map("password_hash") @db.VarChar(255)
  name                   String?  @db.VarChar(100)
  stageName              String?  @map("stage_name") @db.VarChar(100)
  phone                  String?  @db.VarChar(32)
  avatar                 String?  @db.VarChar(2048)
  isActive               Boolean  @default(true) @map("is_active")
  isBanned               Boolean  @default(false) @map("is_banned")
  banReason              String?  @map("ban_reason") @db.VarChar(500)
  failedLoginAttempts    Int      @default(0) @map("failed_login_attempts")
  lockoutUntil           DateTime? @map("lockout_until")
  authzVersion           Int      @default(1) @map("authz_version")
  passwordChangedAt      DateTime @default(now()) @map("password_changed_at")
  twoFactorEnabled       Boolean  @default(false) @map("two_factor_enabled")
  twoFactorMethods       String[] @default([]) @map("two_factor_methods")
  twoFactorSecret        String?  @map("two_factor_secret") @db.VarChar(255)
  twoFactorRecoveryCodes String[] @default([]) @map("two_factor_recovery_codes")
  language               String   @default("en") @db.VarChar(10)
  timezone               String   @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  currency               String   @default("USD") @db.Char(3)
  theme                  String   @default("dark") @db.VarChar(20)
  notifyReleases         Boolean  @default(true) @map("notify_releases")
  notifyRoyalties        Boolean  @default(true) @map("notify_royalties")
  notifyNews             Boolean  @default(true) @map("notify_news")
  notifyMarketing        Boolean  @default(false) @map("notify_marketing")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  membership         Membership?
  staffRoles         UserStaffRole[]
  sessions           Session[]
  twoFactorCodes     TwoFactorCode[]
  twoFactorChallenges TwoFactorChallenge[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent    Invitation[] @relation("InvitationSender")
  securityEvents     SecurityEvent[]

  @@map("users")
}

model Membership {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @unique @map("user_id") @db.Uuid
  entityId   String     @map("entity_id") @db.Uuid
  entityType EntityType @map("entity_type")
  entityRole EntityRole @map("entity_role")
  businessTitle String?  @map("business_title") @db.VarChar(100)
  entityName String     @map("entity_name") @db.VarChar(255)
  entityPath String     @map("entity_path") @db.VarChar(2048)
  tenantId   String?    @map("tenant_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([entityPath])
  @@map("memberships")
}

model UserStaffRole {
  userId    String    @map("user_id") @db.Uuid
  role      StaffRole
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_staff_roles")
}

model Session {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  familyId         String               @map("family_id") @db.Uuid
  refreshTokenHash String               @unique @map("refresh_token_hash") @db.Char(64)
  replacedById     String?              @unique @map("replaced_by_id") @db.Uuid
  ipAddress        String?              @map("ip_address") @db.VarChar(64)
  userAgent        String?              @map("user_agent") @db.VarChar(512)
  deviceName       String?              @map("device_name") @db.VarChar(100)
  deviceType       String?              @map("device_type") @db.VarChar(30)
  location         String?              @db.VarChar(255)
  latitude         Decimal?             @db.Decimal(8, 6)
  longitude        Decimal?             @db.Decimal(9, 6)
  riskScore        Int?                 @map("risk_score")
  loginType        String?              @map("login_type") @db.VarChar(40)
  expiresAt        DateTime             @map("expires_at")
  lastUsedAt       DateTime             @default(now()) @map("last_used_at")
  revokedAt        DateTime?            @map("revoked_at")
  revokeReason     SessionRevokeReason? @map("revoke_reason")
  createdAt        DateTime             @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy Session? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   Session? @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model TwoFactorCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  method    String    @db.VarChar(20)
  expiresAt DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, method, expiresAt])
  @@map("two_factor_codes")
}

model TwoFactorChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  allowedMethods String[]  @map("allowed_methods")
  rememberMe     Boolean   @default(false) @map("remember_me")
  attempts       Int       @default(0)
  secret         String?   @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("two_factor_challenges")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Invitation {
  id         String       @id @default(uuid()) @db.Uuid
  entityId   String       @map("entity_id") @db.Uuid
  entityType EntityType   @map("entity_type")
  entityName String       @map("entity_name") @db.VarChar(255)
  entityPath String       @map("entity_path") @db.VarChar(2048)
  tenantId   String?      @map("tenant_id") @db.Uuid
  email      String       @db.VarChar(254)
  role       EntityRole   @default(MEMBER)
  businessTitle String?   @map("business_title") @db.VarChar(100)
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  status     InviteStatus @default(PENDING)
  invitedBy  String       @map("invited_by") @db.Uuid
  expiresAt  DateTime     @map("expires_at")
  acceptedAt DateTime?    @map("accepted_at")
  lastSentAt DateTime     @default(now()) @map("last_sent_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  inviter User @relation("InvitationSender", fields: [invitedBy], references: [id])

  @@index([entityId, status])
  @@index([email, status])
  @@map("invitations")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String   @db.VarChar(80)
  severity  String   @default("info") @db.VarChar(20)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  requestId String?  @map("request_id") @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

model OutboxEvent {
  id                String   @id @default(uuid()) @db.Uuid
  eventId           String   @unique @map("event_id") @db.Uuid
  type              String   @db.VarChar(100)
  requestId         String   @map("request_id") @db.Uuid
  actorId           String?  @map("actor_id") @db.Uuid
  tenantId          String?  @map("tenant_id") @db.Uuid
  entityPath        String?  @map("entity_path") @db.VarChar(2048)
  payloadCiphertext String   @map("payload_ciphertext") @db.Text
  payloadIv         String   @map("payload_iv") @db.VarChar(32)
  payloadAuthTag    String   @map("payload_auth_tag") @db.VarChar(32)
  occurredAt        DateTime @default(now()) @map("occurred_at")
  publishedAt       DateTime? @map("published_at")
  attempts          Int      @default(0)
  lastError         String?  @map("last_error") @db.VarChar(500)
  nextAttemptAt     DateTime @default(now()) @map("next_attempt_at")

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@map("outbox_events")
}

model EntitySnapshot {
  id         String     @id @db.Uuid
  entityType EntityType @map("entity_type")
  businessTier String?  @map("business_tier") @db.VarChar(16)
  name       String     @db.VarChar(255)
  path       String     @db.VarChar(2048)
  tenantId   String?    @map("tenant_id") @db.Uuid
  isActive   Boolean    @default(true) @map("is_active")
  version    Int
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([path])
  @@map("entity_snapshots")
}
