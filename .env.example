# Upload Server Environment Variables
# Copy this file to .env and fill in your values

PORT=3001
DATABASE_URL=postgresql://app_backend:CHANGE_ME@localhost:5432/bealpha_db

# Server-to-server authentication key (MUST match UPLOAD_API_KEY in dashboard .env)
UPLOAD_API_KEY=CHANGE_ME_GENERATE_RANDOM_32_CHAR_STRING

# Copyright Detection (AudD API)
AUDD_API_TOKEN=CHANGE_ME_YOUR_AUDD_TOKEN
COPYRIGHT_CHECK_ENABLED=true

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Rate Limiting
RATE_LIMIT_MAX=120
MAX_CONCURRENT_UPLOADS_PER_IP=3
MAX_CONCURRENT_STREAMS_GLOBAL=60
MAX_CONCURRENT_STREAMS_PER_IP=8
STREAM_TTL_SEC=3600
